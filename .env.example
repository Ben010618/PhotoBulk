# ==============================================================================
# KameraPh Studio Suite: Environment Configuration (.env.example)
# ==============================================================================

# 1. AI Vision & Beautification (Google Gemini API)
GEMINI_API_KEY=your_gemini_api_key_here
AI_MODEL=gemini-3.1-flash-lite
AI_PROVIDER=google_gemini
AI_DRESSING_MODE=ai_generative_fit
AI_BEAUTIFY_MODE=ai_neural_frequency

# 2. Cloudflare R2 Zero-Egress Object Storage
R2_ACCOUNT_ID=your_cloudflare_account_id
R2_ACCESS_KEY_ID=your_r2_access_key_id
R2_SECRET_ACCESS_KEY=your_r2_secret_access_key
R2_BUCKET_NAME=kameraph-photos
R2_PUBLIC_DOMAIN=https://photos.kameraph.com

# 3. PayMongo / Philippine Payment Gateway
PAYMONGO_SECRET_KEY=prv_test_your_secret_key
PAYMONGO_PUBLIC_KEY=pub_test_your_public_key
PAYMONGO_WEBHOOK_SECRET=whsk_test_your_webhook_secret

# 4. Modal.com Serverless Cloud GPU Fleet (Optional)
MODAL_TOKEN_ID=your_modal_token_id
MODAL_TOKEN_SECRET=your_modal_token_secret
MODAL_ENVIRONMENT=main
MODAL_APP_NAME=kamera-ph-engine

# 5. Database Configuration (PostgreSQL / SQLite fallback)
DATABASE_URL=sqlite:///./kameraph.db
DATABASE_TYPE=sqlite
# For production PostgreSQL / Supabase:
# DATABASE_URL=postgresql://postgres:password@localhost:5432/kameraph
# DATABASE_TYPE=postgres

# 6. Server & Security Configuration
PORT=8000
HOST=127.0.0.1
DEBUG=False
JWT_SECRET=change_this_to_a_secure_random_string_in_production
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,https://your-studio-domain.com
PROOF_BASE_URL=https://photos.kameraph.com/proof
MAX_UPLOAD_SIZE_MB=25
MAX_IMAGE_MEGAPIXELS=50
